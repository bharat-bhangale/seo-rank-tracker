# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://localhost:27017/seo-rank-tracker

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
ENABLE_WORKERS=false

# JWT
JWT_ACCESS_SECRET=change-this-to-a-256-bit-secret
JWT_REFRESH_SECRET=change-this-to-a-different-256-bit-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/settings/integrations/google/callback

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# Browserbase
BROWSERBASE_API_KEY=your-browserbase-api-key
BROWSERBASE_PROJECT_ID=your-browserbase-project-id
STAGEHAND_MODEL=google/gemini-2.5-flash

# SerpApi
SERPAPI_KEY=your-serpapi-key
SERPAPI_COST_PER_SEARCH=0.01

# DataForSEO
DATAFORSEO_LOGIN=your-login
DATAFORSEO_PASSWORD=your-password

# Email (Resend)
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=noreply@yourdomain.com

# Sentry
SENTRY_DSN=your-sentry-dsn
